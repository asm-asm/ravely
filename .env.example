PORT=3000
# auto: no keys = demo, both keys = live. Production defaults to live if omitted.
RAVELRY_MODE=auto
# API application's Basic Auth read-only credentials (NOT your login password).
RAVELRY_API_USERNAME=
RAVELRY_API_PASSWORD=
# Comma-separated frontend origins, without paths or trailing slashes.
CORS_ORIGINS=http://localhost:3000
# Anonymous daily counts only. Production /admin requires a secret token.
ANALYTICS_ENABLED=true
ANALYTICS_ADMIN_TOKEN=
# On Render, set this to a path on an attached persistent disk.
ANALYTICS_FILE=./data/analytics.json
